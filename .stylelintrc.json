{
  "rules": {
    "color-no-hex": true,
    "color-named": "never"
  },
  "overrides": [
    {
      "files": ["*.scss"],
      "customSyntax": "postcss-scss"
    },
    {
      "files": ["*.vue"],
      "customSyntax": "postcss-html"
    },
    {
      "files": ["src/styles/theme*.css", "src/style.css"],
      "rules": {
        "color-no-hex": null
      }
    }
  ],
  "ignoreFiles": ["node_modules/**", "dist/**"]
}
